+                raise ValueError("Pier subnet pool exhausted")
+            networks = [str(ipaddress.ip_network((int(pool.network_address) + (index + offset) * 8, 29))) for offset in (0, 1)]
+            allocations["next"] = index + 2
+            state.seek(0)
+            state.truncate()
+            json.dump(allocations, state)
+            state.flush()
+            os.fsync(state.fileno())
+        compose["networks"]["pier-egress-internal"]["ipam"] = {"config": [{"subnet": networks[0]}]}
