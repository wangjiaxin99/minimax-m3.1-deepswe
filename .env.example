# Run: cp .env.example .env; edit absolute paths before using Compose.
REPO_DIR=/absolute/path/to/minimax-m3.1-deepswe
# Existing local checkpoint; environment build does not download model weights.
MODEL_PATH=/data/models/my-minimax-checkpoint
MODEL_FORMAT=mxfp8
GPU_IDS=4,5,6,7
# Dedicated directory on a large disk; never point at an existing daemon root.
SANDBOX_DATA_DIR=/data/deepswe-sandbox-docker
SERVER_PORT=8201
RUN_REL=runs/vllm-run/1111_01_mxfp8_deepswe_mini_c64_out64k_a3_nodelete
# These three networks must not overlap with host/VPN/Docker networks.
CONTROL_SUBNET=172.30.0.0/24
CONTROL_GATEWAY=172.30.0.1
SANDBOX_IP=172.30.0.2
TASK_SUBNET_POOL=198.18.0.0/15
DAEMON_ADDRESS_POOL=172.28.0.0/16
DAEMON_BRIDGE=172.31.0.1/16
# Fixed vLLM base image digest.
VLLM_BASE_IMAGE=vllm/vllm-openai-rocm@sha256:ae8681212aa5291d8c27f06e90016435e3fca144a68fd5c439231f6475f74569
