FROM docker:28.3.2-cli@sha256:a07d3db92e0ca51de11fd47c9b45257a7c3d64a5b6dae2393382a86a100f42a5 AS docker_cli
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv
FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ARG PIER_COMMIT=b26211ed2bbee6d145f6b8c5b80e39f18b296f08
ARG COMPOSE_VERSION=2.38.2
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git patch && rm -rf /var/lib/apt/lists/*
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=uv /uv /usr/local/bin/uv
RUN mkdir -p /usr/local/libexec/docker/cli-plugins && \
    curl -fL --retry 3 "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
    -o /usr/local/libexec/docker/cli-plugins/docker-compose && \
    echo "486b3ffc0f806ca2efbc430cef89955386011662f0c76bad17c103d059cfa9cf  /usr/local/libexec/docker/cli-plugins/docker-compose" | sha256sum -c - && \
    chmod +x /usr/local/libexec/docker/cli-plugins/docker-compose
RUN git init /opt/pier && git -C /opt/pier remote add origin https://github.com/datacurve-ai/pier.git && \
    git -C /opt/pier fetch --depth 1 origin "$PIER_COMMIT" && git -C /opt/pier checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/pier rev-parse HEAD)" = "$PIER_COMMIT"
COPY patches/002-pier-provider-subnets.patch patches/003-pier-mini-provider-allowlist.patch /opt/patches/
RUN cd /opt/pier && git apply --check /opt/patches/002-pier-provider-subnets.patch && \
    git apply /opt/patches/002-pier-provider-subnets.patch && \
    git apply --check /opt/patches/003-pier-mini-provider-allowlist.patch && \
    git apply /opt/patches/003-pier-mini-provider-allowlist.patch
ENV UV_PROJECT_ENVIRONMENT=/opt/pier-venv UV_PYTHON_DOWNLOADS=never
RUN cd /opt/pier && uv sync --frozen --no-dev --python /usr/local/bin/python
ENV PATH="/opt/pier-venv/bin:${PATH}"
RUN pier run --help >/dev/null && docker compose version && \
    python -c 'import importlib.metadata as m; assert m.version("datacurve-pier") == "0.3.1"'
CMD ["sleep", "infinity"]
